@startuml HEMS_Architecture
' SmartCORE HEMS - architecture as deployed, September 2026.
' Render: https://www.plantuml.com/plantuml (paste) or `java -jar plantuml.jar architecture_diagram.puml`
!theme plain
skinparam defaultTextAlignment center
skinparam componentStyle rectangle
skinparam linetype polyline
skinparam ArrowFontSize 9
skinparam ComponentFontSize 10
skinparam PackageFontSize 11
skinparam PackageBorderThickness 2
skinparam ComponentBorderThickness 1.5
skinparam ArrowThickness 1.5

skinparam package {
  BackgroundColor #f8f9fa
  BorderColor     #6c757d
  FontStyle       bold
}
skinparam component {
  BackgroundColor #1a1a2e
  FontColor       #ffffff
  BorderColor     #444
}
skinparam cloud {
  BackgroundColor #4a235a
  FontColor       #ffffff
  BorderColor     #7d3c98
}
skinparam actor {
  BackgroundColor #1a5276
  FontColor       #0b0b0b
  BorderColor     #2980b9
}

left to right direction

' =====================================================================
' SITE EQUIPMENT - differs per site, configured in the HA UI, not in git
' =====================================================================

package "Site equipment  (one arrangement per site)" as PHYS {

  component "Solar inverter + Solarman logger\n(Sofar G3, LSW Wi-Fi stick)\nModbus/TCP on the home LAN\n1 site" as SOLARMAN

  component "Sigenergy inverter + battery\nModbus/TCP on the home LAN\n1 site" as SIGEN

  component "ESB smart meter\npulse LED, 1000 pulses = 1 kWh" as METER
  component "frient EMIZB-141\nZigbee meter interface\ncounts the LED pulses" as FRIENT
  component "Sonoff ZBDongle-E\nEZSP USB coordinator\n/dev/ttyUSB0\n2 sites" as DONGLE

  METER  -down-> FRIENT : optical pulse
  FRIENT -down-> DONGLE : IEEE 802.15.4\n(Zigbee)
}

' =====================================================================
' THE BOX
' =====================================================================

package "Raspberry Pi 5  ·  balenaOS  ·  8 containers" as RPI {

  package "hems  ·  Docker bridge  ·  172.18.4.0/24" as BRIDGE {

    component "nginx-reverse-proxy\n172.18.4.4 : 80  (published :80)\n──────────────────\n/              → Home Assistant\n/influx/       → InfluxDB UI (path rewrite)\n/configurator/ → configurator, basic auth\n                 CONFIG_USER / CONFIG_PASSWORD\nstream :7845 → eesmart-d2l (undefined)" as NGINX

    package "Home Assistant  ·  172.18.4.2 : 8123\nghcr.io/home-assistant/home-assistant:2026.6.3  ·  volume hass-config" as HA {

      component "Integrations (per site, in .storage)\n──────────────────\nsolarman  (HACS custom)\nsigenergy (custom)\nzha       (built-in, owns the dongle)\nenergyid  (custom, sends to hooks.energyid.eu)\n──────────────────\nNo MQTT integration configured" as INTEG

      component "State machine + event bus\nevery entity change fires\nstate_changed" as STATE

      component "InfluxDB integration\nconfiguration.yaml:\n  host 172.18.4.3  org hems\n  bucket home_assistant\n  token !env_var INFLUX_TOKEN\n  include domains: [sensor]\nwrites on change only" as IINT

      INTEG -right-> STATE : sensor.* entities
      STATE -right-> IINT  : state_changed\n(domain = sensor)
    }

    component "InfluxDB 2.7.1\n172.18.4.3 : 8086  (published :8086)\n──────────────────\norg hems · bucket home_assistant\nmeasurement = unit (W, kWh, V ...)\ntag entity_id · field value | state\nvolume influxdb-data" as INFLUX

    component "hass-configurator\n172.18.4.6 : 3218  (NOT published)\n──────────────────\nedits the hass-config volume\nreached only via nginx + login" as CONF

    component "Mosquitto MQTT\n172.18.4.7 : 1883  (published :1883)\n──────────────────\nallow_anonymous true\nIDLE: no publisher, no subscriber\nkept for future MQTT devices" as MQTT

    component "led-status\n172.18.4.9\n──────────────────\nGPIO 17  HA reachable   (ping .2)\nGPIO 27  internet        (ping 8.8.8.8)\nGPIO 22  ERROR in HA log\nreads hass-config volume" as LEDS
  }

  package "Host network  (no bridge IP)" as HOSTNET {

    component "system-manager  (Alpine + Python)\n──────────────────\nevery 30 s via Supervisor API:\n1. stop wifi-connect after\n   PORTAL_MAX_MINUTES (10)\n2. restart HA when releaseId changes\n3. reboot after 30 min without internet\niptables.sh: bridge ↔ 10.42.0.0/24 (inert)\nvolume /data: version.txt, restartLog.txt" as SM

    component "wifi-connect  (Debian bookworm)\n──────────────────\non boot, wait ≤60 s for a network\n(default route or Wi-Fi assoc.)\n• network → skip, delete stale AP profile\n• none → hotspot “WiFi Connect”\n  WPA2 PORTAL_PASSPHRASE\n  portal 192.168.42.1:8080\nNET_ADMIN + host D-Bus (NetworkManager)" as WIFIC
  }
}

' =====================================================================
' CLOUD AND PEOPLE
' =====================================================================

cloud "balenaCloud\nfleet smartcoremtu/smartcore\n7 devices\n──────────────────\nreleases (draft → pin → finalize)\nservice variables\nSupervisor API on each device\nssh / tunnel / logs for the team" as BALENA

cloud "EnergyID\nhooks.energyid.eu\n(one site)" as ENERGYID

actor "Homeowner\nbrowser / HA app\nhome LAN only\nhttp://<pi-ip>/" as USER

actor "MTU team\nbalena CLI + dashboard" as TEAM

' =====================================================================
' CONNECTIONS
' =====================================================================

SOLARMAN -down-> INTEG : Modbus/TCP\n(solarman)
SIGEN    -down-> INTEG : Modbus/TCP\n(sigenergy)
DONGLE   -down-> INTEG : USB serial, EZSP\n(HA privileged: true)

IINT -down-> INFLUX : POST /api/v2/write\nline protocol

NGINX -down-> HA     : proxy + WebSocket
NGINX -down-> INFLUX : proxy + sub_filter
NGINX -down-> CONF   : proxy, auth_basic

INTEG -up-> ENERGYID : webhook

SM -up-> BALENA : Supervisor REST API\n(127.0.0.1:48484)
LEDS ..> HA : ICMP

USER -up-> NGINX : http://<pi-ip>:80
TEAM -up-> BALENA : balena push / pin / ssh
BALENA -down-> RPI : OTA releases, variables

@enduml
